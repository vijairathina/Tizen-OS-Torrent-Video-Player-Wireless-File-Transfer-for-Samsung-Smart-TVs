    "supportedAudioExtensions": ["mp3", "aac", "flac", "wav", "ogg", "m4a"],
    "supportedSubtitleExtensions": ["srt", "vtt"],
    "bufferForPlaybackMs": 2500,
    "bufferForPlaybackAfterRebufferMs": 5000
  }
