{
  "server": {
    "defaultHostIp": "192.168.0.14",
    "httpPort": 8080,
    "torrentStreamPort": 8889,
    "webSocketPath": "/ws",
    "ssePath": "/events"
  },
  "client": {
    "networkTimeoutMs": 10000,
